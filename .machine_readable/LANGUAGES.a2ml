# LANGUAGES.a2ml — canonical language registry for the nextgen-languages coordinator.
# Originally migrated from LANGUAGES.scm.

[metadata]
version = "0.2.0"
last-updated = "2026-07-02"
migrated-from = "LANGUAGES.scm"

# =============================================================================
# Structured language registry.
#
# Canonical schema: [[language]] array-of-tables —
#   id / name / repo / invariant / role / [ecosystem] / [note] / status
#
# Scope: the 14 family languages + the KitchenSpeak DSL (+ proposed entries,
# clearly marked). The database / type-theory estates (VCL-total, the KRL
# resolution stack, Quandledb, TypeLL, PanLL, VQL/GQL/FBQL-DT, a2ml, k9-svc)
# are OUT of this registry and are listed only for discoverability in
# docs/language-portfolio.md ("separate scope") and TOOLING-STATUS.adoc
# ("Adjacent estates").
#
# The legacy commented s-expression content (migrated from LANGUAGES.scm, and
# marked "do not parse") was removed 2026-07-02 as part of a registry
# reconciliation; recover it from git history (this file prior to that date) or
# from LANGUAGES.scm if ever needed. It modelled Solo/Duet/Ensemble as
# top-level languages and claimed "eight languages", both of which are stale.
# =============================================================================

[[language]]
id = "my-lang"
name = "My-Lang"
repo = "https://github.com/hyperpolymath/my-lang"
invariant = "Each level builds exactly on the previous"
role = "Nested dialect family Solo ⊂ Duet ⊂ Ensemble; Me is a runtime projection (tentacles-agentic-syllabus/me), not a fourth dialect"
status = "active"

[[language]]
id = "phronesis"
name = "Phronesis"
repo = "https://github.com/hyperpolymath/phronesis"
invariant = "Every AI decision traces to declared values"
role = "Formal, auditable agent ethics"
status = "active"

[[language]]
id = "eclexia"
name = "Eclexia"
repo = "https://github.com/hyperpolymath/eclexia"
invariant = "No computation without explicit resource budget"
role = "Resource-first / green computing"
status = "active"

[[language]]
id = "oblibeny"
name = "Oblíbený"
repo = "https://github.com/hyperpolymath/oblibeny"
invariant = "All programs must provably terminate"
role = "Turing-incomplete secure deployment"
status = "active"

[[language]]
id = "anvomidav"
name = "Anvomidav"
repo = "https://github.com/hyperpolymath/anvomidav"
invariant = "Every deadline is statically guaranteed"
role = "Hard real-time / formal verification"
status = "active"

[[language]]
id = "wokelang"
name = "WokeLang"
repo = "https://github.com/hyperpolymath/wokelang"
invariant = "No operation without explicit consent"
role = "Consent & well-being as language primitives"
status = "active"

[[language]]
id = "betlang"
name = "betlang"
repo = "https://github.com/hyperpolymath/betlang"
invariant = "All uncertainty must be explicitly modeled"
role = "Foundational / probabilistic experiment"
status = "active"

[[language]]
id = "jtv"
name = "JtV"
repo = "https://github.com/hyperpolymath/jtv"
invariant = "Data and code are strictly separated"
role = "Systems language, Harvard architecture; BoJ dialect injection"
status = "active"

[[language]]
id = "affinescript"
name = "AffineScript"
repo = "https://github.com/hyperpolymath/affinescript"
invariant = "Every resource is used at most once"
role = "Affine types targeting WasmGC (typed-wasm)"
status = "active"

[[language]]
id = "ephapax"
name = "Ephapax"
repo = "https://github.com/hyperpolymath/ephapax"
invariant = "Every value can be consumed exactly once"
role = "Dyadic linear/affine types targeting WasmGC"
status = "active"

[[language]]
id = "haec"
name = "Haec"
repo = "https://github.com/hyperpolymath/haec"
invariant = "Every quality-loss is graded and checked against its use"
role = "Trope-particularity: graded property-instance loss, lowered to a language-neutral Trope IR, use-checked"
ecosystem = ["https://github.com/hyperpolymath/trope-checker", "https://github.com/hyperpolymath/trope-particularity-workbench"]
status = "design"

[[language]]
id = "error-lang"
name = "Error-Lang"
repo = "https://github.com/hyperpolymath/error-lang"
invariant = "Errors are first-class: systems thinking taught through failure"
role = "Pedagogical language, systems thinking via errors"
status = "active"

[[language]]
id = "tangle"
name = "Tangle"
repo = "https://github.com/hyperpolymath/tangle"
invariant = "Programs are braids; equivalence is topological isotopy"
role = "Topological (knot/braid) language; core mechanised in Lean"
note = "TangleIR is consumed by the separate KRL resolution stack (krl → TangleIR → VeriSimCore → Skein.jl/quandledb) — that stack is out of coordinator scope"
status = "active"

[[language]]
id = "007"
name = "007"
repo = "https://github.com/The-Metadatastician/007"
invariant = "Agents that make agents"
role = "Agent meta-language"
note = "PRIVATE repo (dual-use precaution, anti-training-scrape). Indexed only; do not mirror content here. Pointer: languages/007.md"
status = "specification"

[[language]]
id = "kitchenspeak"
name = "KitchenSpeak"
repo = "https://github.com/hyperpolymath/kitchenspeak"
invariant = "Physical-process constraints are enforced in the types"
role = "Orchestration DSL (kitchen domain, physics-in-types); consumes the echo-types substrate"
note = "Extracted from this coordinator 2026-06; in-tree snapshot removed (EXTRACTION-MANIFEST.md)"
status = "experimental"

# ─── Proposed (destination repo not yet created; registered for discoverability only) ───
[[language]]
id = "typefix-zero"
name = "TypeFix Zero (TF0)"
repo = "https://github.com/hyperpolymath/typefix-zero"
invariant = "The total mathematical fragment and the partial computational fragment (fix) are explicitly separated"
role = "Universe-stratified STLC + Nat + one fixed-point primitive; minimal typed teaching core"
note = "PROPOSED — destination repo does not exist yet; design spec parked at extraction-queue/typefix-zero/SPEC.adoc"
status = "proposed"
