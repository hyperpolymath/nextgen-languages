# SPDX-License-Identifier: MPL-2.0
# Coordinator contract task definitions.
# Keep in sync with the generated root `contractile.just` task surface.

must-check: must-license-present must-readme-present must-coordinator-boundary must-language-registry
    @echo "All coordinator MUST checks passed"

must-license-present:
    test -f LICENSE

must-readme-present:
    test -f README.adoc

must-coordinator-boundary:
    bash hooks/validate-coordinator-boundary.sh

must-language-registry:
    bash hooks/validate-language-registry.sh

trust-verify: trust-license-content trust-no-secrets-committed
    @echo "Trust checks passed"

trust-license-content:
    grep -q 'SPDX\|License\|MPL' LICENSE

trust-no-secrets-committed:
    test ! -f .env && test ! -f credentials.json && test ! -f .env.local && test ! -f .env.production
