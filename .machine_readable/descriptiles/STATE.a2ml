[blockers]
action-sha-pins = "bash hooks/validate-sha-pins.sh reports 29 mutable tag refs across workflows. The official gh-actions-lock extension is not installed and release-asset downloads failed with EOF in this environment. The existing generated actions.lock maps tags to commits but does not make workflow uses lines SHA-pinned. Do not hand-edit the generated lock; rerun gh actions-lock with its safe no-migrate/no-onboard options when the tool is available."

