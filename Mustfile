# Coordinator mandatory checks. No language compiler build/test is claimed here.

version: 1

checks:
  - name: license-present
    run: test -f LICENSE
  - name: registry-consistency
    run: bash hooks/validate-language-registry.sh
  - name: coordinator-boundary
    run: bash hooks/validate-coordinator-boundary.sh
  - name: diff-whitespace
    run: git diff --check
